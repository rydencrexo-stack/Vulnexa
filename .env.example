# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Replace this in every non-development environment.
JWT_SECRET=change-me-with-at-least-32-random-characters
COOKIE_SECURE=false

# External integrations stay server-side.
ACUNETIX_BASE_URL=
ACUNETIX_API_KEY=
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=mock-security-analyst

# Local runtime storage
EVIDENCE_DIRECTORY=./backend/evidence
REPORT_DIRECTORY=./backend/reports
SCANNER_MOCK_MODE=true
CLOUD_MODE=false
JSON_BACKUPS=true
