# PAN backend development configuration. Copy to .env and load it in your shell.
PAN_ENV=development
JWT_SECRET=replace-with-at-least-48-random-characters
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Storage
DATA_DIRECTORY=./data
EVIDENCE_DIRECTORY=./evidence
REPORT_DIRECTORY=./reports
JSON_BACKUPS=true

# Cookies and platform safety
COOKIE_SECURE=false
CLOUD_MODE=false
SCANNER_MOCK_MODE=true
SCANNER_TIMEOUT_SECONDS=1800
SCANNER_STEP_SECONDS=0.35
MAX_SCAN_REQUEST_LIMIT=10000
MAX_SCAN_CONCURRENCY=10
ALLOW_EXTERNAL_INTEGRATIONS=false

# Dedicated Acunetix adapter (environment-only; never stored in JSON)
ACUNETIX_BASE_URL=
ACUNETIX_API_KEY=

# Provider-neutral AI adapter (mock works without credentials)
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=pan-safe-analyst
AGENT_MIN_SCAN_SECONDS=32.0
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash

# Optional Telegram credential-search bot (run: python -m app.services.telegram_bot)
# Only load datasets you are authorized to hold.
TELEGRAM_BOT_TOKEN=
TELEGRAM_COMBOLIST_DIR=./data/combolist
TELEGRAM_OWNER_HANDLE=
# Comma-separated numeric Telegram user IDs granted premium results
TELEGRAM_PREMIUM_USERS=
